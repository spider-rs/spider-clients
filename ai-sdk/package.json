{
  "name": "@spider-cloud/ai-sdk",
  "version": "0.1.0",
  "description": "Spider scrape, crawl, search and links tools for the Vercel AI SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test __tests__/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "spider",
    "ai-sdk",
    "vercel",
    "ai",
    "tools",
    "web-scraping",
    "web-crawler",
    "web-search",
    "markdown"
  ],
  "author": "Spider <support@spider.cloud>",
  "license": "MIT",
  "homepage": "https://github.com/spider-rs/spider-clients/tree/main/ai-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spider-rs/spider-clients.git",
    "directory": "ai-sdk"
  },
  "bugs": {
    "url": "https://github.com/spider-rs/spider-clients/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ai": "7.0.166",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  }
}
